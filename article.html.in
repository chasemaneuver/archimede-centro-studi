<!doctype html><html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#004a59"><title>{{article.seoTitle}} · Archimede Centro Studi</title><meta name="description" content="{{article.description}}"><link rel="canonical" href="{{article.canonical}}"><meta property="og:title" content="{{article.seoTitle}}"><meta property="og:description" content="{{article.description}}"><meta property="og:url" content="{{article.canonical}}"><meta property="og:type" content="article"><meta property="og:image" content="{{article.imageAbsolute}}"><meta name="twitter:card" content="summary_large_image"><link rel="icon" href="./logo.png"><link rel="stylesheet" href="./styles.css?v=footer-ente-20261009"><link rel="stylesheet" href="./archive.css?v=20261007"><script type="application/ld+json">{{article.schema}}</script></head><body><a class="skip" href="#contenuto">Vai al contenuto</a>{{header}}<main id="contenuto"><section class="page-intro article-heading"><div class="wrap"><nav class="breadcrumbs" aria-label="Percorso di navigazione"><a href="./index.html">Home</a><span>/</span><a href="./articoli.html">Articoli</a><span>/</span><span aria-current="page">{{article.title}}</span></nav><span class="eyebrow">{{article.eyebrow}}</span><h1>{{article.titleFirst}}<br><em>{{article.titleEmphasis}}</em></h1><div class="article-meta"><time datetime="{{article.date}}">{{article.dateLabel}}</time><span>{{article.readingLabel}}</span><span>{{article.author}}</span></div><div class="article-tags">{{article.tags}}</div></div></section><div class="wrap article-layout"><article class="article-body">{{article.body}}<div class="article-share"><a href="https://wa.me/?text={{article.canonical}}" target="_blank" rel="noopener">Condividi su WhatsApp ↗</a><a href="mailto:?subject={{article.shareSubject}}&amp;body={{article.canonical}}">Condividi via email ↗</a></div>{{article.comments}}</article><aside class="article-side"><strong>{{article.section}}</strong><p>{{article.sidebarDescription}}</p><a href="./articoli.html">Tutti gli articoli ↗</a><a href="./risorse.html">Risorse gratuite ↗</a></aside></div></main>{{footer}}
  <a class="whatsapp" href="{{contacts.whatsapp}}" target="_blank" rel="noopener" aria-label="Contatta Archimede su WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20l1.3-4.6A8.5 8.5 0 1 1 20.5 11.5Z"/><path d="M8 7c.5 4 3 6.5 7 7l1.5-2-2-1-1 1c-1.4-.7-2.3-1.6-3-3l1-1-1-2Z"/></svg></a>
  <script src="./site.js" defer></script>{{article.commentScripts}}</body></html>

