<!doctype html><html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#004a59"><title>{{event.title}} · Archimede Centro Studi</title><meta name="description" content="{{event.description}}"><link rel="canonical" href="{{event.canonical}}"><meta property="og:title" content="{{event.title}}"><meta property="og:description" content="{{event.description}}"><meta property="og:url" content="{{event.canonical}}"><meta property="og:type" content="website"><meta property="og:image" content="{{event.imageAbsolute}}"><meta name="twitter:card" content="summary_large_image"><link rel="icon" href="./logo.png"><link rel="stylesheet" href="./styles.css?v=footer-ente-20261009"><link rel="stylesheet" href="./archive.css?v=20261007"><script type="application/ld+json">{{event.schema}}</script></head><body><a class="skip" href="#contenuto">Vai al contenuto</a>{{header}}<main id="contenuto"><section class="page-intro article-heading"><div class="wrap"><nav class="breadcrumbs" aria-label="Percorso di navigazione"><a href="./index.html">Home</a><span>/</span><a href="./eventi.html">Eventi</a><span>/</span><span aria-current="page">{{event.title}}</span></nav><span class="eyebrow">{{event.eyebrow}}</span><h1>{{event.titleFirst}}<br><em>{{event.titleEmphasis}}</em></h1><p>{{event.intro}}</p><div class="article-meta"><span>{{event.statusLabel}}</span><span>Conclusione: <time datetime="{{event.end}}">{{event.endLabel}}</time></span></div><div class="article-tags">{{event.tags}}</div></div></section><div class="wrap article-layout"><article class="article-body"><figure class="article-image"><a href="{{event.imageUrl}}"><img src="{{event.imageUrl}}" alt="{{event.title}}"></a></figure>{{event.body}}{{event.registration}}</article><aside class="article-side"><strong>Le nostre iniziative</strong><p>Occasioni per imparare e crescere insieme.</p><a href="./eventi.html">Tutti gli eventi ↗</a><a href="./index.html#contatti">Parliamone insieme ↗</a></aside></div></main>{{footer}}<script src="./site.js" defer></script></body></html>
