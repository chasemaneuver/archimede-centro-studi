<article class="archive-card event-card"{{event.endAttribute}} data-status="{{event.status}}" data-tags="{{event.tagsData}}"><a href="{{event.url}}"><img class="event-poster" src="{{event.imageUrl}}" alt="{{event.title}}" loading="lazy"><div><span class="eyebrow event-status">{{event.statusLabel}}</span><h2>{{event.title}}</h2><p>{{event.desc}}</p><p>{{event.period}}</p><span>Scopri l’iniziativa ↗</span></div></a></article>