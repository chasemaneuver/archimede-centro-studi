</g>
<circle cx="250" cy="185" r="4" fill="#103b66" class="services-satellite" data-phase="0" /><circle cx="250" cy="185" r="4" fill="#c93b2b" class="services-satellite" data-phase="3.141592653589793" /></svg></div></div></div></section><section class="reviews-platform-band" aria-label="Valutazioni sulle piattaforme"><div class="wrap"><div class="review-platforms"><div class="google-summary platform-summary" id="google"><div><strong>{{google.ratingLabel}}/5 <span class="google-stars" aria-hidden="true">★★★★★</span></strong><span>Media su Google Maps · {{google.count}} recensioni</span></div><div class="review-summary-links"><a class="text-link" href="{{google.url}}" target="_blank" rel="noopener">Leggi tutte le recensioni su Google Maps <span aria-hidden="true">↗</span></a><p>Valutazione consultata il <time datetime="{{google.checkedAt}}">{{google.checkedLabel}}</time>.</p><a class="review-write-badge" href="{{links.googleWriteReview}}" target="_blank" rel="noopener" aria-label="Scrivi una recensione su Google Maps"><span aria-hidden="true">☆</span> Scrivi una recensione <span aria-hidden="true">↗</span></a></div></div><div class="google-summary platform-summary" id="facebook"><div><strong>{{facebook.positivePercent}}%</strong><span>Valutazioni positive su Facebook · {{facebook.count}} recensioni</span></div><div class="review-summary-links"><a class="text-link" href="{{facebook.url}}" target="_blank" rel="noopener">Leggi tutte le recensioni su Facebook <span aria-hidden="true">↗</span></a><p>Valutazione consultata il <time datetime="{{facebook.checkedAt}}">{{facebook.checkedLabel}}</time>.</p><a class="review-write-badge" href="{{links.facebookWriteReview}}" target="_blank" rel="noopener" aria-label="Scrivi una recensione su Facebook"><span aria-hidden="true">☆</span> Scrivi una recensione <span aria-hidden="true">↗</span></a></div></div><div class="google-summary platform-summary trustpilot-summary" id="trustpilot"><div><strong>{{trustpilot.scoreLabel}}/5 <span class="google-stars trustpilot-stars" aria-hidden="true"><span>★★★★★</span><span class="trustpilot-stars-fill" style="width:{{trustpilot.starsPercent}}%">★★★★★</span></span></strong><span>TrustScore su Trustpilot · {{trustpilot.count}} recensioni</span></div><div class="review-summary-links"><a class="text-link" href="https://it.trustpilot.com/review/archimedecentrostudi.com" target="_blank" rel="noopener">Leggi tutte le recensioni su Trustpilot <span aria-hidden="true">↗</span></a>
