<article class="archive-card" data-tags="{{article.tagsData}}"><a href="{{article.url}}"><img src="{{article.imageUrl}}" width="{{article.imageWidth}}" height="{{article.imageHeight}}" alt="{{article.cardAlt}}" loading="lazy"><div><span class="eyebrow">{{article.section}}</span><h2>{{article.title}}</h2><p>{{article.cardMeta}}</p><p>{{article.summary}}</p><span>Leggi l’articolo ↗</span></div></a><div class="article-tags">{{article.tags}}</div></article>